<%
const posts = [
  {
    image: "blog-01.jpg",
    date: "Dec 22, 2023",
    title: "Meet AutoManage, the best AI management tools",
    delay: ".1s"
  },
  {
    image: "blog-02.jpg",
    date: "Mar 15, 2023",
    title: "How to earn more money as a wellness coach",
    delay: ".15s"
  },
  {
    image: "blog-03.jpg",
    date: "Jan 05, 2023",
    title: "The no-fuss guide to upselling and cross selling",
    delay: ".2s"
  }
];
%>
<section id="blog" class="bg-white pb-10 pt-20 lg:pb-20 lg:pt-[120px]">
  <div class="container px-4 mx-auto">
    <div class="flex flex-wrap justify-center -mx-4">
      <div class="w-full px-4">
        <div class="mx-auto mb-[60px] max-w-[485px] text-center">
          <span class="block mb-2 text-lg font-semibold text-primary">Our Blogs</span>
          <h2 class="mb-4 text-3xl font-bold text-dark sm:text-4xl md:text-[40px] md:leading-[1.2]">
            Our Recent News
          </h2>
          <p class="text-base text-body-color">
            There are many variations of passages of Lorem Ipsum available
            but the majority have suffered alteration in some form.
          </p>
        </div>
      </div>
    </div>
    <div class="flex flex-wrap -mx-4">
      <% posts.forEach(function (post) { %>
        <div class="w-full px-4 md:w-1/2 lg:w-1/3">
          <%~ include("/partials/blog-card", { ...page, post: { ...post, href: "#blog" } }) %>
        </div>
      <% }); %>
    </div>
  </div>
</section>
