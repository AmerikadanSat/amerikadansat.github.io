<%
const techLogos = [
  { name: "Technology 1", icon: "hero-tech-1" },
  { name: "Technology 2", icon: "hero-tech-2" },
  { name: "Technology 3", icon: "hero-tech-3" },
  { name: "Technology 4", icon: "hero-tech-4" },
  { name: "Technology 5", icon: "hero-tech-5" }
];
%>
<div id="home" class="relative overflow-hidden bg-primary pt-[120px] md:pt-[130px] lg:pt-[160px]">
  <div class="container px-4 mx-auto">
    <div class="flex flex-wrap items-center -mx-4">
      <div class="w-full px-4">
        <div class="hero-content wow fadeInUp mx-auto max-w-[780px] text-center" data-wow-delay=".2s">
          <h1 class="mb-6 text-3xl font-bold leading-snug text-white sm:text-4xl sm:leading-snug lg:text-5xl lg:leading-[1.2]">
            Open-Source Web Template for SaaS, Startup, Apps, and More
          </h1>
          <p class="mx-auto mb-9 max-w-[600px] text-base font-medium text-white sm:text-lg sm:leading-[1.44]">
            Multidisciplinary Web Template Built with Your Favourite
            Technology - HTML Bootstrap, Tailwind and React NextJS.
          </p>
          <ul class="flex flex-wrap items-center justify-center gap-5 mb-10">
            <li>
              <a
                href="https://themewagon.com/themes/play-tailwind/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-md bg-white px-7 py-[14px] text-center text-base font-medium text-dark shadow-1 transition duration-300 ease-in-out hover:bg-gray-2 hover:text-body-color"
              >
                Download Now
              </a>
            </li>
            <li>
              <a
                href="https://github.com/themewagon/play-tailwind"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-4 rounded-md bg-white/[0.12] px-6 py-[14px] text-base font-medium text-white transition duration-300 ease-in-out hover:bg-white hover:text-dark"
              >
                <%~ include("/partials/play/icons/hero-github", page) %>
                Star on Github
              </a>
            </li>
          </ul>
          <div>
            <p class="mb-4 text-base font-medium text-center text-white">
              Built with latest technology
            </p>
            <div class="flex items-center justify-center gap-4 text-center wow fadeInUp" data-wow-delay=".3s">
              <% techLogos.forEach(function (logo) { %>
                <a
                  href="#"
                  onclick="event.preventDefault();"
                  class="duration-300 ease-in-out text-white/60 hover:text-white"
                  aria-label="<%= logo.name %>"
                >
                  <%~ include(`/partials/play/icons/${logo.icon}`, page) %>
                </a>
              <% }); %>
            </div>
          </div>
        </div>
      </div>

      <div class="w-full px-4">
        <div class="wow fadeInUp relative z-10 mx-auto max-w-[845px]" data-wow-delay=".25s">
          <div class="mt-16">
            <img
              src="/images/hero/hero-image.jpg"
              alt="Play dashboard preview"
              class="max-w-full mx-auto rounded-t-xl rounded-tr-xl"
            />
          </div>
          <div class="absolute -left-9 bottom-0 z-[-1]">
            <%~ include("/partials/play/icons/hero-decoration-left", page) %>
          </div>
          <div class="absolute -right-6 -top-6 z-[-1]">
            <%~ include("/partials/play/icons/hero-decoration-right", page) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
