<%
const plans = [
  { name: "Starter", price: "25.00", recommended: false },
  { name: "Basic", price: "59.00", recommended: true },
  { name: "Premium", price: "99.00", recommended: false }
];
const planFeatures = [
  "Up to 1 User",
  "All UI components",
  "Lifetime access",
  "Free updates"
];
%>
<section id="pricing" class="relative z-20 overflow-hidden bg-white pb-12 pt-20 lg:pb-[90px] lg:pt-[120px]">
  <div class="container px-4 mx-auto">
    <div class="flex flex-wrap -mx-4">
      <div class="w-full px-4">
        <div class="mx-auto mb-[60px] max-w-[510px] text-center">
          <span class="block mb-2 text-lg font-semibold text-primary">Pricing Table</span>
          <h2 class="mb-3 text-3xl font-bold text-dark sm:text-4xl md:text-[40px] md:leading-[1.2]">
            Awesome Pricing Plan
          </h2>
          <p class="text-base text-body-color">
            There are many variations of passages of Lorem Ipsum available
            but the majority have suffered alteration in some form.
          </p>
        </div>
      </div>
    </div>
    <div class="flex flex-wrap justify-center -mx-4">
      <% plans.forEach(function (plan) { %>
        <div class="w-full px-4 md:w-1/2 lg:w-1/3">
          <div class="relative z-10 px-8 py-10 mb-10 overflow-hidden bg-white rounded-xl shadow-pricing sm:p-12 lg:px-6 lg:py-10 xl:p-14">
            <% if (plan.recommended) { %>
              <p class="absolute right-[-50px] top-[60px] inline-block -rotate-90 rounded-bl-md rounded-tl-md bg-primary px-5 py-2 text-base font-medium text-white">
                Recommended
              </p>
            <% } %>
            <span class="block mb-5 text-xl font-medium text-dark"><%= plan.name %></span>
            <h2 class="mb-11 text-4xl font-semibold text-dark xl:text-[42px] xl:leading-[1.21]">
              <span class="text-xl font-medium">$</span>
              <span class="-ml-1 -tracking-[2px]"><%= plan.price %></span>
              <span class="text-base font-normal text-body-color">Per Month</span>
            </h2>
            <div class="mb-[50px]">
              <h5 class="mb-5 text-lg font-medium text-dark">Features</h5>
              <div class="flex flex-col gap-[14px]">
                <% planFeatures.forEach(function (feature) { %>
                  <p class="text-base text-body-color"><%= feature %></p>
                <% }); %>
              </div>
            </div>
            <a
              href="#contact"
              class="inline-block py-3 text-base font-medium text-center text-white transition rounded-md bg-primary px-7 hover:bg-blue-dark"
            >
              Purchase Now
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>
