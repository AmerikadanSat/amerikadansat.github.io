<%
const banner = it.banner ?? {};
const title = banner.title ?? it.title ?? "Page";
const description = banner.description ?? "There are many variations of passages of Lorem Ipsum available.";
const breadcrumb = banner.breadcrumb ?? title;
const homeHref = banner.homeHref ?? "/";
%>
<div class="relative z-10 overflow-hidden pb-[60px] pt-[120px] md:pt-[130px] lg:pt-[160px]">
  <div class="absolute bottom-0 left-0 h-px w-full bg-linear-to-r from-stroke/0 via-stroke to-stroke/0"></div>
  <div class="container px-4 mx-auto">
    <div class="flex flex-wrap items-center -mx-4">
      <div class="w-full px-4">
        <div class="text-center">
          <h1 class="mb-4 text-3xl font-bold text-dark sm:text-4xl md:text-[40px] md:leading-[1.2]">
            <%= title %>
          </h1>
          <p class="mb-5 text-base text-body-color"><%= description %></p>

          <ul class="flex items-center justify-center gap-[10px]">
            <li>
              <a href="<%= homeHref %>" class="flex items-center gap-[10px] text-base font-medium text-dark">
                Home
              </a>
            </li>
            <li>
              <span class="flex items-center gap-[10px] text-base font-medium text-body-color">
                <span class="text-body-color"> / </span>
                <%= breadcrumb %>
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
