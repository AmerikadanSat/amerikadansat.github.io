<section id="contact" class="relative py-20 md:py-[120px]">
  <div class="absolute left-0 top-0 -z-1 h-1/2 w-full bg-[#E9F9FF] lg:h-[45%] xl:h-1/2"></div>
  <div class="container px-4 mx-auto">
    <div class="flex flex-wrap items-center -mx-4">
      <div class="w-full px-4 lg:w-7/12 xl:w-8/12">
        <div class="ud-contact-content-wrapper">
          <div class="ud-contact-title mb-12 lg:mb-[150px]">
            <span class="block mb-6 text-base font-medium text-dark">CONTACT US</span>
            <h2 class="max-w-[260px] text-[35px] font-semibold leading-[1.14] text-dark">
              Let's talk about your problem.
            </h2>
          </div>
          <div class="flex flex-wrap justify-between mb-12 lg:mb-0">
            <div class="mb-8 flex w-[330px] max-w-full">
              <div class="mr-6 text-[32px] text-primary">
                <%~ include("/partials/icons/contact-location", page) %>
              </div>
              <div>
                <h5 class="mb-[18px] text-lg font-semibold text-dark">Our Location</h5>
                <p class="text-base text-body-color">
                  401 Broadway, 24th Floor, Orchard Cloud View, London
                </p>
              </div>
            </div>
            <div class="mb-8 flex w-[330px] max-w-full">
              <div class="mr-6 text-[32px] text-primary">
                <%~ include("/partials/icons/contact-email", page) %>
              </div>
              <div>
                <h5 class="mb-[18px] text-lg font-semibold text-dark">How Can We Help?</h5>
                <p class="text-base text-body-color">
                  <a href="mailto:info@yourdomain.com" class="hover:text-primary">info@yourdomain.com</a>
                </p>
                <p class="mt-1 text-base text-body-color">
                  <a href="mailto:contact@yourdomain.com" class="hover:text-primary">contact@yourdomain.com</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="w-full px-4 lg:w-5/12 xl:w-4/12">
        <div
          class="wow fadeInUp rounded-lg bg-white px-8 py-10 shadow-testimonial sm:px-10 sm:py-12 md:p-[60px] lg:p-10 lg:px-10 lg:py-12 2xl:p-[60px]"
          data-wow-delay=".2s"
        >
          <h3 class="mb-8 text-2xl font-semibold text-dark md:text-[28px] md:leading-[1.42]">
            Send us a Message
          </h3>
          <form action="#" method="post">
            <div class="mb-[22px]">
              <label for="fullName" class="block mb-4 text-sm text-body-color">Full Name*</label>
              <input
                type="text"
                id="fullName"
                name="fullName"
                placeholder="Adam Gelius"
                autocomplete="name"
                required
                class="w-full border-0 border-b border-[#f1f1f1] bg-transparent pb-3 text-body-color placeholder:text-body-color/60 focus:border-primary focus:outline-hidden"
              />
            </div>
            <div class="mb-[22px]">
              <label for="email" class="block mb-4 text-sm text-body-color">Email*</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="example@yourmail.com"
                autocomplete="email"
                required
                class="w-full border-0 border-b border-[#f1f1f1] bg-transparent pb-3 text-body-color placeholder:text-body-color/60 focus:border-primary focus:outline-hidden"
              />
            </div>
            <div class="mb-[22px]">
              <label for="phone" class="block mb-4 text-sm text-body-color">Phone*</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+885 1254 5211 552"
                autocomplete="tel"
                required
                class="w-full border-0 border-b border-[#f1f1f1] bg-transparent pb-3 text-body-color placeholder:text-body-color/60 focus:border-primary focus:outline-hidden"
              />
            </div>
            <div class="mb-[30px]">
              <label for="message" class="block mb-4 text-sm text-body-color">Message*</label>
              <textarea
                id="message"
                name="message"
                rows="1"
                placeholder="type your message here"
                required
                class="w-full resize-none border-0 border-b border-[#f1f1f1] bg-transparent pb-3 text-body-color placeholder:text-body-color/60 focus:border-primary focus:outline-hidden"
              ></textarea>
            </div>
            <div class="mb-0">
              <button
                type="submit"
                class="inline-flex items-center justify-center px-10 py-3 text-base font-medium text-white transition duration-300 ease-in-out rounded-md bg-primary hover:bg-blue-dark"
              >
                Send
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
