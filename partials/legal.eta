<%
const legalIntro = it.legalIntro ?? "Bu sayfanın içeriği hazırlanmaktadır.";
const legalDetails = it.legalDetails ?? "Kısa süre içinde güncel metin bu sayfada yayınlanacaktır. Bu süreçte sorularınız için bizimle iletişime geçebilirsiniz.";
const whatsappHref = "https://wa.me/15551234567?text=Merhaba%2C%20yasal%20bilgilendirme%20sayfalar%C4%B1%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum.";
%>
<section class="bg-white pb-20 pt-10 lg:pb-[110px] lg:pt-16">
  <div class="container px-4 mx-auto">
    <div class="mx-auto max-w-[820px]">
      <div class="rounded-2xl border border-stroke bg-gray-1 p-8 sm:p-10">
        <span class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary">
          <span class="h-2 w-2 rounded-full bg-primary"></span>
          Yasal Bilgilendirme
        </span>
        <h2 class="mb-4 text-2xl font-bold leading-tight text-dark sm:text-3xl">
          İçerik Hazırlanıyor
        </h2>
        <p class="mb-4 text-base leading-relaxed text-body-color">
          <%= legalIntro %>
        </p>
        <p class="mb-8 text-base leading-relaxed text-body-color">
          <%= legalDetails %>
        </p>
        <a
          href="<%= whatsappHref %>"
          target="_blank"
          rel="noopener noreferrer"
          class="whatsapp-cta inline-flex items-center justify-center gap-2 rounded-md bg-whatsapp px-6 py-3 text-base font-medium text-black transition duration-300 ease-in-out hover:bg-whatsapp-dark"
        >
          <img
            src="/images/whatsapp-icon.svg"
            alt=""
            class="h-5 w-5"
            width="20"
            height="20"
            aria-hidden="true"
          />
          WhatsApp'tan Bize Ulaşın
        </a>
      </div>
    </div>
  </div>
</section>
