<%
const aboutLinks = [
  { label: "Home", href: "#home" },
  { label: "Features", href: "#features" },
  { label: "About", href: "#about" },
  { label: "Testimonial", href: "#testimonials" }
];
const featureLinks = [
  { label: "How it works", href: "#features" },
  { label: "Privacy policy", href: "#" },
  { label: "Terms of Service", href: "#" },
  { label: "Refund policy", href: "#" }
];
const productLinks = [
  { label: "LineIcons", href: "https://lineicons.com/" },
  { label: "Ecommerce HTML", href: "https://ecommercehtml.com/" },
  { label: "TailAdmin", href: "https://tailadmin.com/" },
  { label: "PlainAdmin", href: "https://plainadmin.com/" }
];
const legalLinks = [
  { label: "Privacy policy", href: "#" },
  { label: "Legal notice", href: "#" },
  { label: "Terms of service", href: "#" }
];
const footerSocials = [
  { label: "Facebook", icon: "footer-facebook" },
  { label: "Twitter", icon: "footer-twitter" },
  { label: "Instagram", icon: "footer-instagram" },
  { label: "LinkedIn", icon: "footer-linkedin" }
];
const latestPosts = [
  { image: "blog-footer-01.jpg", title: "I think really important to design with..." },
  { image: "blog-footer-02.jpg", title: "Recognizing the need is the primary..." }
];
%>
<footer class="wow fadeInUp relative z-10 bg-[#090E34] pt-20 lg:pt-[100px]" data-wow-delay=".15s">
  <div class="container px-4 mx-auto">
    <div class="flex flex-wrap -mx-4">
      <div class="w-full px-4 sm:w-1/2 md:w-1/2 lg:w-4/12 xl:w-3/12">
        <div class="w-full mb-10">
          <a href="#home" class="mb-6 inline-block max-w-[160px]" aria-label="Play home">
            <img src="/assets/images/logo/logo-white.svg" alt="Play" class="max-w-full" width="132" height="46" />
          </a>
          <p class="mb-8 max-w-[270px] text-base text-gray-7">
            We create digital experiences for brands and companies by using
            technology.
          </p>
          <div class="flex items-center -mx-3">
            <% footerSocials.forEach(function (social) { %>
              <a
                href="#"
                onclick="event.preventDefault();"
                class="px-3 text-gray-7 hover:text-white"
                aria-label="<%= social.label %>"
              >
                <%~ include(`/partials/play/icons/${social.icon}`, page) %>
              </a>
            <% }); %>
          </div>
        </div>
      </div>
      <div class="w-full px-4 sm:w-1/2 md:w-1/2 lg:w-2/12 xl:w-2/12">
        <div class="w-full mb-10">
          <h4 class="text-lg font-semibold text-white mb-9">About Us</h4>
          <ul>
            <% aboutLinks.forEach(function (link) { %>
              <li>
                <a href="<%= link.href %>" class="inline-block mb-3 text-base text-gray-7 hover:text-primary"><%= link.label %></a>
              </li>
            <% }); %>
          </ul>
        </div>
      </div>
      <div class="w-full px-4 sm:w-1/2 md:w-1/2 lg:w-3/12 xl:w-2/12">
        <div class="w-full mb-10">
          <h4 class="text-lg font-semibold text-white mb-9">Features</h4>
          <ul>
            <% featureLinks.forEach(function (link) { %>
              <li>
                <a
                  href="<%= link.href %>"
                  <% if (link.href === "#") { %>onclick="event.preventDefault();"<% } %>
                  class="inline-block mb-3 text-base text-gray-7 hover:text-primary"
                ><%= link.label %></a>
              </li>
            <% }); %>
          </ul>
        </div>
      </div>
      <div class="w-full px-4 sm:w-1/2 md:w-1/2 lg:w-3/12 xl:w-2/12">
        <div class="w-full mb-10">
          <h4 class="text-lg font-semibold text-white mb-9">Our Products</h4>
          <ul>
            <% productLinks.forEach(function (link) { %>
              <li>
                <a
                  href="<%= link.href %>"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block mb-3 text-base text-gray-7 hover:text-primary"
                ><%= link.label %></a>
              </li>
            <% }); %>
          </ul>
        </div>
      </div>
      <div class="w-full px-4 md:w-2/3 lg:w-6/12 xl:w-3/12">
        <div class="w-full mb-10">
          <h4 class="text-lg font-semibold text-white mb-9">Latest blog</h4>
          <div class="flex flex-col gap-8">
            <% latestPosts.forEach(function (post) { %>
              <a href="#blog" class="group flex items-center gap-[22px]">
                <div class="overflow-hidden rounded-sm">
                  <img src="/assets/images/blog/<%= post.image %>" alt="" loading="lazy" />
                </div>
                <span class="max-w-[180px] text-base text-gray-7 group-hover:text-white"><%= post.title %></span>
              </a>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-12 border-t border-[#8890A4]/40 py-8 lg:mt-[60px]">
    <div class="container px-4 mx-auto">
      <div class="flex flex-wrap -mx-4">
        <div class="w-full px-4 md:w-2/3 lg:w-1/2">
          <div class="my-1">
            <div class="flex items-center justify-center -mx-3 md:justify-start">
              <% legalLinks.forEach(function (link) { %>
                <a
                  href="<%= link.href %>"
                  onclick="event.preventDefault();"
                  class="px-3 text-base text-gray-7 hover:text-white hover:underline"
                ><%= link.label %></a>
              <% }); %>
            </div>
          </div>
        </div>
        <div class="w-full px-4 md:w-1/3 lg:w-1/2">
          <div class="flex justify-center my-1 md:justify-end">
            <p class="text-base text-center text-gray-7 md:text-left">
              Designed and Developed by
              <a
                href="https://tailgrids.com"
                rel="nofollow noopener"
                target="_blank"
                class="text-gray-1 hover:underline"
              >TailGrids and UIdeck</a>.
              Distributed by
              <a
                href="https://themewagon.com"
                rel="nofollow noopener"
                target="_blank"
                class="text-gray-1 hover:underline"
              >ThemeWagon</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div>
    <span class="absolute left-0 top-0 z-[-1]">
      <img src="/assets/images/footer/shape-1.svg" alt="" />
    </span>
    <span class="absolute bottom-0 right-0 z-[-1]">
      <img src="/assets/images/footer/shape-3.svg" alt="" />
    </span>
    <span class="absolute right-0 top-0 z-[-1]">
      <%~ include("/partials/play/icons/footer-dots", page) %>
    </span>
  </div>
</footer>

<a
  href="#home"
  class="fixed left-auto items-center justify-center hidden w-10 h-10 text-white transition duration-300 ease-in-out rounded-md shadow-md back-to-top bottom-8 right-8 z-999 bg-primary hover:bg-dark"
  aria-label="Back to top"
>
  <span class="mt-[6px] h-3 w-3 rotate-45 border-l border-t border-white"></span>
</a>
