<%
const posts = [
    { image: "blog-01.jpg", date: "Dec 22, 2023", title: "Meet AutoManage, the best AI management tools", delay: ".1s" },
    { image: "blog-02.jpg", date: "Mar 15, 2023", title: "How to earn more money as a wellness coach", delay: ".15s" },
    { image: "blog-03.jpg", date: "Jan 05, 2023", title: "The no-fuss guide to upselling and cross selling", delay: ".2s" },
    { image: "blog-02.jpg", date: "Mar 15, 2023", title: "How to earn more money as a wellness coach", delay: ".1s" },
    { image: "blog-03.jpg", date: "Jan 05, 2023", title: "The no-fuss guide to upselling and cross selling", delay: ".15s" },
    { image: "blog-01.jpg", date: "Dec 22, 2023", title: "Meet AutoManage, the best AI management tools", delay: ".2s" },
    { image: "blog-01.jpg", date: "Dec 22, 2023", title: "Meet AutoManage, the best AI management tools", delay: ".1s" },
    { image: "blog-02.jpg", date: "Mar 15, 2023", title: "How to earn more money as a wellness coach", delay: ".15s" },
    { image: "blog-03.jpg", date: "Jan 05, 2023", title: "The no-fuss guide to upselling and cross selling", delay: ".2s" }
];
page = {
    "title": "Blog Grids | Play",
    "description": "Read the latest news, guides, and insights from the Play team.",
    "siteName": "Play",
    "language": "en",
    "banner": {
        "title": "Blog Grid",
        "breadcrumb": "Blog Grid"
    },
    ...it
};
%>
<% layout("../layouts/tr/default", page) %>
<%~ include("/partials/play/banner", page) %>
<section class="pt-20 pb-10 dark:bg-dark lg:pb-20 lg:pt-[120px]">
  <div class="container px-4 mx-auto">
    <div class="flex flex-wrap -mx-4">
      <% posts.forEach(function (post) { %>
        <div class="w-full px-4 md:w-1/2 lg:w-1/3">
          <%~ include("/partials/play/blog-card", { ...page, post: post }) %>
        </div>
      <% }); %>
    </div>
    <%~ include("/partials/play/pagination", page) %>
  </div>
</section>
