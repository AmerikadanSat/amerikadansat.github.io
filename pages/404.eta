<%
page = {
    "title": "404 Page",
    "description": "The page you are looking for could not be found.",
    "language": "en",
    "banner": {
        "title": "404 Page",
        "breadcrumb": "404"
    },
    ...it
};
%>
<% layout("../layouts/default", page) %>
<%~ include("/partials/banner", page) %>
<section class="bg-white py-20 lg:py-[110px]">
  <div class="container px-4 mx-auto">
    <div class="flex flex-wrap items-center -mx-4">
      <div class="w-full px-4 md:w-5/12 lg:w-6/12">
        <div class="text-center">
          <img src="/images/404.svg" alt="Page not found illustration" class="max-w-full mx-auto" />
        </div>
      </div>
      <div class="w-full px-4 md:w-7/12 lg:w-6/12 xl:w-5/12">
        <div>
          <div class="mb-8">
            <%~ include("/partials/icons/error-404", page) %>
          </div>
          <h2 class="mb-5 text-2xl font-semibold text-dark">
            We Can't Seem to Find The Page You're Looking For.
          </h2>
          <p class="mb-8 text-base text-body-color">
            Oops! The page you are looking for does not exist. It might have
            been moved or deleted.
          </p>
          <a
            href="/"
            class="rounded-md bg-dark px-7 py-3 text-base font-medium text-white transition hover:bg-primary"
          >
            Go To Home
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
